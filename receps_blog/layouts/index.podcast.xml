{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0"
     xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd"
     xmlns:content="http://purl.org/rss/1.0/modules/content/"
     xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Site.Title }} (Podcast Edition)</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Site.Params.description | default "Technical articles on HPC, AI, and systems engineering." }}</description>
    <language>{{ .Site.Language.Locale | default "en-us" }}</language>
    <copyright>{{ .Site.Params.extra.copyright | default .Site.Title }}</copyright>
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    <atom:link href="{{ "podcast.xml" | absURL }}" rel="self" type="application/rss+xml" />
    <itunes:subtitle>Listen to technical articles on the go</itunes:subtitle>
    <itunes:author>{{ .Site.Params.author | default "Recep Erol" }}</itunes:author>
    <itunes:summary>Listen to technical blog posts by {{ .Site.Params.author | default "Recep Erol" }}. Perfect for commuting, driving, or workouts.</itunes:summary>
    <itunes:owner>
      <itunes:name>{{ .Site.Params.author | default "Recep Erol" }}</itunes:name>
      <itunes:email>{{ .Site.Params.social.email | default "recep.90@gmail.com" }}</itunes:email>
    </itunes:owner>
    <itunes:image href="{{ "Recep.jpeg" | absURL }}" />
    <itunes:category text="Technology" />
    <itunes:explicit>false</itunes:explicit>

    {{ range where .Site.RegularPages "Section" "posts" }}
      {{ $slug := .File.TranslationBaseName }}
      {{ if eq $slug "index" }}
        {{ $slug = (path.Base .File.Dir) }}
      {{ end }}
      {{ $audioSrc := "" }}
      {{ if .Params.audio }}
        {{ $audioSrc = .Params.audio | absURL }}
      {{ else }}
        {{ $staticCandidate := printf "static/audio/%s.mp3" $slug }}
        {{ if fileExists $staticCandidate }}
          {{ $audioSrc = printf "audio/%s.mp3" $slug | absURL }}
        {{ end }}
      {{ end }}

      {{ if $audioSrc }}
      <item>
        <title>{{ .Title }}</title>
        <link>{{ .Permalink }}</link>
        <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
        <guid isPermaLink="true">{{ .Permalink }}</guid>
        <description>{{ .Summary | plainify }}</description>
        <enclosure url="{{ $audioSrc }}" length="2500000" type="audio/mpeg" />
        <itunes:author>{{ .Site.Params.author | default "Recep Erol" }}</itunes:author>
        <itunes:summary>{{ .Summary | plainify }}</itunes:summary>
        <itunes:explicit>false</itunes:explicit>
      </item>
      {{ end }}
    {{ end }}
  </channel>
</rss>

